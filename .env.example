NODE_ENV=development
HOST=127.0.0.1
API_PORT=3100
POSTGRES_HOST_PORT=15432
API_HOST_PORT=13100
DASHBOARD_HOST_PORT=15173
DATABASE_URL=postgresql://cryptoanal:cryptoanal@127.0.0.1:15432/cryptoanal_dev?schema=public
DASHBOARD_ORIGIN=http://localhost:5173
DEVELOPMENT_WORKSPACE_ID=development
AUTH_SECRET=replace-with-at-least-32-random-characters
# Development only. Replace in every shared or production environment.
EXCHANGE_CREDENTIALS_KEY=Y3J5cHRvYW5hbC1kZXYtY3JlZGVudGlhbHMta2V5ISE=
AUTH_SESSION_TTL_HOURS=168
AUTH_MAX_ACTIVE_SESSIONS=10
AUTH_RECOVERY_TTL_MINUTES=60
LOG_LEVEL=info
BYBIT_PUBLIC_BASE_URL=https://api.bybit.com
BYBIT_DEMO_BASE_URL=https://api-demo.bybit.com
BYBIT_LIVE_BASE_URL=https://api.bybit.com
# Optional: leave unset if Bybit REST works directly from the worker.
# HTTP CONNECT proxy must be running and reachable from Docker, e.g. Happ on macOS:
# BYBIT_PROXY_URL=http://host.docker.internal:10820
BYBIT_PRIVATE_REQUEST_TIMEOUT_MS=10000
EXCHANGE_VERIFICATION_INTERVAL_HOURS=24
EXCHANGE_VERIFICATION_RETRY_MINUTES=15
EXCHANGE_VERIFICATION_LEASE_SECONDS=120
EXCHANGE_VERIFICATION_POLL_INTERVAL_MS=60000
MARKET_POLL_INTERVAL_MS=30000
CANDLE_POLL_INTERVAL_MS=60000
INSTRUMENT_SYNC_INTERVAL_MS=300000
BYBIT_PUBLIC_WS_URL=wss://stream.bybit.com/v5/public/linear
ACCOUNT_SNAPSHOT_INTERVAL_MS=300000
RUNTIME_POLL_INTERVAL_MS=5000
RUNTIME_QUOTE_INTERVAL_MS=1000
RUNTIME_QUOTE_MAX_AGE_MS=10000
RUNTIME_ENTRY_MAX_SPREAD_BPS=20
RUNTIME_EXIT_TRIGGER_SOURCE=LastPrice
RUNTIME_EXIT_MAX_SPREAD_BPS=50
RUNTIME_EXIT_MAX_SLIPPAGE_BPS=50
RUNTIME_EXIT_BOOK_MAX_AGE_MS=1000
RUNTIME_EXIT_ORDER_TTL_MS=5000
RUNTIME_ENTRY_MAX_SLIPPAGE_BPS=50
RUNTIME_ENTRY_BOOK_MAX_AGE_MS=1000
RUNTIME_ENTRY_MAKER_PARTICIPATION_BPS=1000
RUNTIME_MARKET_ENTRY_TTL_MS=60000
RUNTIME_MARKET_ENTRY_MAX_DEVIATION_BPS=50
RUNTIME_RECOVERY_TIMEOUT_MS=5000
RUNTIME_POSITION_CONCURRENCY=4
RUNTIME_EVENT_RETENTION_HOURS=24
RUNTIME_TRACE_RETENTION_DAYS=30
RUNTIME_MARK_PERSIST_INTERVAL_MS=5000
WATCHDOG_INTERVAL_MS=30000
DRY_RUN_ACCOUNT_ID=development-dry-run
DRY_RUN_INITIAL_BALANCE=10000

# Включать только для удалённого development-стенда.

# Optional DRY_RUN per-position profit protection. Unset date keeps it disabled.
# RUNTIME_PROFIT_PROTECTION_ENABLED_AT=2026-10-13T00:00:00.000Z
RUNTIME_PROFIT_BREAK_EVEN_ACTIVATION_R=0.5
RUNTIME_PROFIT_TRAILING_ACTIVATION_R=1
RUNTIME_PROFIT_TRAILING_DISTANCE_R=0.5
