{
  "name": "@cryptoanal/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/server.ts",
    "build": "tsup src/server.ts --format esm --clean --sourcemap",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cryptoanal/application": "workspace:*",
    "@cryptoanal/config": "workspace:*",
    "@cryptoanal/contracts": "workspace:*",
    "@cryptoanal/persistence": "workspace:*",
    "@fastify/cors": "11.3.0",
    "fastify": "5.12.3",
    "fastify-type-provider-zod": "7.0.0",
    "zod": "4.5.4"
  }
}
